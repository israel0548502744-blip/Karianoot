+// NeMo BaseCharsTokenizer.encode (the Hebrew IPA tokenizer of
+// notmax123/magpie_tts_multilingual_357m-he: one token per IPA symbol).
+// Spaces are collapsed (never leading), trailing spaces stripped, symbols
+// outside the vocabulary skipped. On top of NeMo: other whitespace counts as a
+// space, and a few symbols the vocabulary lacks are mapped to the closest one
+// it has (only when the symbol itself is not in the vocabulary).
+std::vector<int32_t> encode_chars(const sub_tokenizer& st, const std::string& text) {
+    static const std::unordered_map<uint32_t, uint32_t> fallback = {
+        {'g', 0x0261}, {'x', 0x03C7}, {0x0263, 0x0281}, {0x0280, 0x0281}, {0x027E, 0x0281},
+        {'w', 'v'}, {0x0292, 0x0283}, {'q', 'k'}, {'c', 'k'}, {'y', 'j'},
+        {';', ','}, {':', ','}, {0x2026, '.'}, {0x05C3, '.'},
+        {'-', ' '}, {0x05BE, ' '}, {0x2013, ' '}, {0x2014, ' '}, {0x00A0, ' '},
+    };
+    std::vector<int32_t> cs;
+    std::string skipped;
+    for (uint32_t cp : utf8_decode(any_locale_pre(text))) {
+        if (cp == '\t' || cp == '\n' || cp == '\r') cp = ' ';
+        std::string c = cp_str(cp);
+        if (cp != ' ' && !st.in_vocab(c)) {
+            if (cp >= 'A' && cp <= 'Z') cp += 0x20;
+            c = cp_str(cp);
+            if (!st.in_vocab(c)) {
+                auto it = fallback.find(cp);
+                if (it != fallback.end()) { cp = it->second; c = cp_str(cp); }
+            }
+        }
+        if (cp == ' ') {
+            if (!cs.empty() && cs.back() != st.space_local) cs.push_back(st.space_local);
+        } else if (c.size() >= 1 && st.in_vocab(c)) {
+            cs.push_back(st.id(c));
+        } else if (cp != 0x02CC) {  // secondary stress: dropped silently
+            skipped += c;
+        }
+    }
+    if (!skipped.empty())
+        MG_LOG("tokenizer %s: skipped unknown symbols '%s'", st.name.c_str(), skipped.c_str());
+    while (!cs.empty() && cs.back() == st.space_local) cs.pop_back();
+    if (st.pad_with_space) {
+        cs.insert(cs.begin(), st.space_local);
+        cs.push_back(st.space_local);
+    }
+    return cs;
+}
